import "ansi.fl"

print(bold("ANSI demo"))
print("")

print("styles:")
print(ANSI_BOLD + "bold" + ANSI_RESET + " " + ANSI_DIM + "dim" + ANSI_RESET + " " + ANSI_ITALIC + "italic" + ANSI_RESET + " " + ANSI_UNDERLINE + "underline" + ANSI_RESET + " " + ANSI_STRIKE + "strike" + ANSI_RESET + " " + ANSI_REVERSE + "reverse" + ANSI_RESET)
print("")

print("wrappers:")
print(red("red") + " " + green("green") + " " + yellow("yellow") + " " + blue("blue") + " " + magenta("magenta") + " " + cyan("cyan") + " " + gray("gray"))
print("")

print("foreground:")
let fg = [ANSI_BLACK, ANSI_RED, ANSI_GREEN, ANSI_YELLOW, ANSI_BLUE, ANSI_MAGENTA, ANSI_CYAN, ANSI_WHITE]
let fgb = [ANSI_BRIGHT_BLACK, ANSI_BRIGHT_RED, ANSI_BRIGHT_GREEN, ANSI_BRIGHT_YELLOW, ANSI_BRIGHT_BLUE, ANSI_BRIGHT_MAGENTA, ANSI_BRIGHT_CYAN, ANSI_BRIGHT_WHITE]
let line = ""
for c in fg { line = line + c + "###" + ANSI_RESET + " " }
print(line)
line = ""
for c in fgb { line = line + c + "###" + ANSI_RESET + " " }
print(line)
print("")

print("background:")
let bg = [ANSI_BG_BLACK, ANSI_BG_RED, ANSI_BG_GREEN, ANSI_BG_YELLOW, ANSI_BG_BLUE, ANSI_BG_MAGENTA, ANSI_BG_CYAN, ANSI_BG_WHITE]
line = ""
for c in bg { line = line + c + "   " + ANSI_RESET + " " }
print(line)
print("")

print("256 colors:")
for row in 0..16 {
    line = ""
    for col in 0..16 {
        line = line + ANSI_bg256(row * 16 + col) + "  " + ANSI_RESET
    }
    print(line)
}
print("")

print("rgb gradient:")
line = ""
for i in 0..64 {
    line = line + ANSI_bg_RGB(i * 4, 64, 255 - i * 4) + " "
}
print(line + ANSI_RESET)
print("")

print(ANSI_BOLD + ANSI_GREEN + "done" + ANSI_RESET)
